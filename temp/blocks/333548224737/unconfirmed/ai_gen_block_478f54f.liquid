{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-store-locator-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 50px 24px 65px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: inherit;
  }

  .ai-store-locator-{{ ai_gen_id }} *,
  .ai-store-locator-{{ ai_gen_id }} *::before,
  .ai-store-locator-{{ ai_gen_id }} *::after { box-sizing: border-box; }

  .ai-store-locator-{{ ai_gen_id }} .store-container { width: 100%; max-width: 1200px; margin: 0 auto; }
  .ai-store-locator-{{ ai_gen_id }} .store-header { text-align: center; margin-bottom: 35px; }
  .ai-store-locator-{{ ai_gen_id }} .store-eyebrow { display: inline-block; padding: 8px 15px; margin-bottom: 12px; border: 1px solid {{ block.settings.border_color }}; border-radius: 30px; background: #fff; color: {{ block.settings.accent_color }}; font-size: 10px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; }
  .ai-store-locator-{{ ai_gen_id }} .store-header h2 { margin: 0 0 10px; color: {{ block.settings.accent_color }}; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(30px, 3.2vw, 44px); line-height: 1.2; font-weight: 700; }
  .ai-store-locator-{{ ai_gen_id }} .store-subtitle { max-width: 570px; margin: 0 auto; color: {{ block.settings.muted_color }}; font-size: 13px; line-height: 1.7; }
  .ai-store-locator-{{ ai_gen_id }} .store-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .ai-store-locator-{{ ai_gen_id }} .store-card { display: flex; flex-direction: column; min-width: 0; overflow: hidden; background: #fff; border: 1px solid {{ block.settings.border_color }}; border-radius: 17px; box-shadow: 0 2px 5px rgba(58,18,39,.04); }
  .ai-store-locator-{{ ai_gen_id }} .store-image { position: relative; width: 100%; height: 205px; overflow: hidden; background: #eee7e8; }
  .ai-store-locator-{{ ai_gen_id }} .store-image img, .ai-store-locator-{{ ai_gen_id }} .store-image svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-store-locator-{{ ai_gen_id }} .store-image-placeholder { width: 100%; height: 100%; }
  .ai-store-locator-{{ ai_gen_id }} .store-empty { position: absolute; right: 12px; bottom: 12px; left: 12px; padding: 7px 10px; background: rgba(255,255,255,.94); color: #33252c; text-align: center; font-size: 12px; }
  .ai-store-locator-{{ ai_gen_id }} .store-city { position: absolute; top: 13px; left: 13px; padding: 8px 13px; border-radius: 25px; background: {{ block.settings.accent_color }}; color: #fff; font-size: 10px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; }
  .ai-store-locator-{{ ai_gen_id }} .store-content { display: flex; flex: 1; flex-direction: column; padding: 20px 18px 18px; }
  .ai-store-locator-{{ ai_gen_id }} .store-name { margin: 0 0 10px; color: {{ block.settings.accent_color }}; font-family: Georgia, 'Times New Roman', serif; font-size: 21px; font-weight: 700; line-height: 1.3; }
  .ai-store-locator-{{ ai_gen_id }} .store-rating { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-bottom: 13px; font-size: 11px; }
  .ai-store-locator-{{ ai_gen_id }} .store-stars { color: #8a5600; font-size: 14px; letter-spacing: -1px; white-space: nowrap; }
  .ai-store-locator-{{ ai_gen_id }} .store-score { color: #30242a; font-weight: 700; }
  .ai-store-locator-{{ ai_gen_id }} .store-reviews { color: {{ block.settings.muted_color }}; font-size: 10px; font-style: italic; }
  .ai-store-locator-{{ ai_gen_id }} .store-address { min-height: 42px; margin: 0 0 16px; color: {{ block.settings.muted_color }}; font-size: 12px; font-style: italic; line-height: 1.65; }
  .ai-store-locator-{{ ai_gen_id }} .store-actions { display: flex; align-items: stretch; gap: 8px; margin-top: auto; }
  .ai-store-locator-{{ ai_gen_id }} .store-btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 43px; padding: 10px 12px; border: 1px solid {{ block.settings.border_color }}; border-radius: 10px; text-align: center; text-decoration: none; font-size: 12px; font-weight: 600; line-height: 1.2; cursor: pointer; }
  .ai-store-locator-{{ ai_gen_id }} .store-btn:focus-visible { outline: 3px solid #33252c; outline-offset: 3px; }
  .ai-store-locator-{{ ai_gen_id }} .store-btn-directions { flex: 1; background: {{ block.settings.accent_color }}; border-color: {{ block.settings.accent_color }}; color: #fff; }
  .ai-store-locator-{{ ai_gen_id }} .store-btn-call { flex-shrink: 0; background: #fff; color: {{ block.settings.accent_color }}; }
  @media screen and (max-width: 900px) { .ai-store-locator-{{ ai_gen_id }} .store-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media screen and (max-width: 600px) { .ai-store-locator-{{ ai_gen_id }} { padding: 36px 16px 44px; } .ai-store-locator-{{ ai_gen_id }} .store-grid { grid-template-columns: 1fr; gap: 16px; } .ai-store-locator-{{ ai_gen_id }} .store-image { height: 220px; } }
{% endstyle %}

<div class="ai-store-locator-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="store-container">
    <header class="store-header">
      {% if block.settings.eyebrow != blank %}<span class="store-eyebrow">{{ block.settings.eyebrow | escape }}</span>{% endif %}
      {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.subtitle != blank %}<p class="store-subtitle">{{ block.settings.subtitle | escape }}</p>{% endif %}
    </header>
    <div class="store-grid">
      {% for i in (1..3) %}
        {% liquid
          assign enabled_key = 'store_' | append: i | append: '_enabled'
          assign name_key = 'store_' | append: i | append: '_name'
          assign city_key = 'store_' | append: i | append: '_city'
          assign address_key = 'store_' | append: i | append: '_address'
          assign image_key = 'store_' | append: i | append: '_image'
          assign rating_key = 'store_' | append: i | append: '_rating'
          assign reviews_key = 'store_' | append: i | append: '_reviews'
          assign directions_key = 'store_' | append: i | append: '_directions'
          assign phone_key = 'store_' | append: i | append: '_phone'
          assign enabled = block.settings[enabled_key]
          assign store_name = block.settings[name_key]
          assign city = block.settings[city_key]
          assign address = block.settings[address_key]
          assign store_image = block.settings[image_key]
          assign rating = block.settings[rating_key]
          assign reviews = block.settings[reviews_key]
          assign directions = block.settings[directions_key]
          assign phone = block.settings[phone_key]
        %}
        {% if enabled %}
          <article class="store-card">
            <div class="store-image">
              {% if store_image != blank %}<img src="{{ store_image | image_url: width: 900 }}" alt="{{ store_image.alt | default: store_name | escape }}" loading="lazy" width="{{ store_image.width }}" height="{{ store_image.height }}">
              {% else %}<div class="store-image-placeholder">{{ 'image' | placeholder_svg_tag }}<span class="store-empty">Add a store photo in block settings</span></div>{% endif %}
              {% if city != blank %}<span class="store-city">{{ city | escape }}</span>{% endif %}
            </div>
            <div class="store-content">
              {% if store_name != blank %}<h3 class="store-name">{{ store_name | escape }}</h3>{% endif %}
              {% if rating != blank or reviews != blank %}<div class="store-rating" aria-label="Store rating information"><span class="store-stars" aria-hidden="true">★★★★★</span>{% if rating != blank %}<span class="store-score">{{ rating | escape }}</span>{% endif %}{% if reviews != blank %}<span class="store-reviews">{{ reviews | escape }}</span>{% endif %}</div>{% endif %}
              {% if address != blank %}<p class="store-address">{{ address | escape | newline_to_br }}</p>{% endif %}
              <div class="store-actions">
                {% if directions != blank %}<a class="store-btn store-btn-directions" href="{{ directions }}" target="_blank" rel="noopener noreferrer">Get directions</a>{% endif %}
                {% if phone != blank %}<a class="store-btn store-btn-call" href="tel:{{ phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | escape }}">Call store</a>{% endif %}
              </div>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Store locator",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Visit us" },
