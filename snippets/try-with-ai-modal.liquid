    margin-top: 2px;
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    accent-color: #993556;
    cursor: pointer;
  }
  .try-ai-modal__privacy a {
    color: #2e1f1f;
    text-decoration: underline;
  }

  /* ── Loading state: AI scan effect over the uploaded photo ── */
  .try-ai-modal__loading {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 2 / 3;
    max-height: 520px;
    margin: 0 auto;
    border-radius: 12px;
    overflow: hidden;
    background: #1a1420;
    border: 1.5px solid #e8e2d9;
  }
  .try-ai-modal__loading-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.7) brightness(0.55) blur(6px);
    transform: scale(1.05);
  }
  .try-ai-modal__loading-mask {
    position: absolute;
    inset: 0;
    background: rgba(20, 14, 26, 0.35);
  }
  .try-ai-modal__loading-scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .try-ai-modal__loading-scan-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #d98a2b, #c3134e, #9c2a8f, transparent);
    box-shadow: 0 0 16px 3px rgba(195, 19, 78, 0.7);
    animation: try-ai-scan-move 2.6s ease-in-out infinite;
  }
  @keyframes try-ai-scan-move {
    0%   { top: 4%; opacity: 0; }
    8%   { opacity: 1; }
    50%  { top: 92%; opacity: 1; }
    92%  { opacity: 1; }
    100% { top: 4%; opacity: 0; }
  }
  .try-ai-modal__loading-corner {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 2px solid rgba(255,255,255,0.85);
    opacity: 0.9;
  }
  .try-ai-modal__loading-corner--tl {
    top: 14px; left: 14px;
    border-right: none; border-bottom: none;
    border-radius: 4px 0 0 0;
  }
  .try-ai-modal__loading-corner--tr {
    top: 14px; right: 14px;
    border-left: none; border-bottom: none;
    border-radius: 0 4px 0 0;
  }
  .try-ai-modal__loading-corner--bl {
    bottom: 14px; left: 14px;
    border-right: none; border-top: none;
    border-radius: 0 0 0 4px;
  }
  .try-ai-modal__loading-corner--br {
    bottom: 14px; right: 14px;
    border-left: none; border-top: none;
    border-radius: 0 0 4px 0;
  }
  .try-ai-modal__loading-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 28px 20px 24px;
    background: linear-gradient(180deg, transparent, rgba(20, 14, 26, 0.9) 45%);
  }
  .try-ai-modal__loading-sparkle {
    color: #fff;
    filter: drop-shadow(0 0 8px rgba(195, 19, 78, 0.8));
    animation: try-ai-btn-icon-twinkle 1.6s ease-in-out infinite;
  }
  .try-ai-modal__loading-step {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.875rem;
    color: #fff;
    margin: 0;
    text-align: center;
    min-height: 1.4em;
  }
  .try-ai-modal__loading-progress {
    width: 100%;
    max-width: 260px;
  }
  .try-ai-modal__loading-progress-track {
    width: 100%;
    height: 4px;
    border-radius: 4px;
    background: rgba(255,255,255,0.2);
    overflow: hidden;
  }
  .try-ai-modal__loading-progress-fill {
    height: 100%;
    width: 0%;
    border-radius: 4px;
    background: linear-gradient(90deg, #d98a2b, #c3134e, #9c2a8f);
    transition: width 0.6s ease;
  }
  .try-ai-modal__loading-progress-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255,255,255,0.75);
  }

  /* ── Result step: image left, product panel right ── */
  .try-ai-modal__step--result {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media screen and (min-width: 700px) {
    .try-ai-modal__step--result {
      flex-direction: row;
      align-items: flex-start;
    }
    .try-ai-modal__step--result .try-ai-modal__compare {
      flex: 0 0 320px;
      margin: 0;
    }
    .try-ai-modal__product-panel {
      flex: 1;
      min-width: 0;
      padding-top: 4px;
    }
  }

  /* ── Result / before-after compare ── */
  .try-ai-modal__compare {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 2 / 3;
    max-height: 520px;
    margin: 0 auto;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    border: 1.5px solid #e8e2d9;
    user-select: none;
    touch-action: pan-y;
  }
  .try-ai-modal__compare-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }
  .try-ai-modal__compare-before-wrap {
    position: absolute;
    inset: 0;
    width: 50%;
    overflow: hidden;
  }
  .try-ai-modal__compare-before-wrap .try-ai-modal__compare-img {
    width: var(--compare-width, 100vw);
    max-width: none;
  }
  .try-ai-modal__compare-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 40px;
    margin-left: -20px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: ew-resize;
  }
  .try-ai-modal__compare-handle::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 6px rgba(0,0,0,0.3);
  }
  .try-ai-modal__compare-handle-grip {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    color: #2e1f1f;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  }
  .try-ai-modal__compare-label {
    position: absolute;
    bottom: 10px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
    background: rgba(0,0,0,0.5);
    padding: 3px 10px;
    border-radius: 20px;
    pointer-events: none;
  }
  .try-ai-modal__compare-label--before { left: 10px; }
  .try-ai-modal__compare-label--after { right: 10px; }

  .try-ai-modal__compare--no-original .try-ai-modal__compare-before-wrap,
  .try-ai-modal__compare--no-original .try-ai-modal__compare-handle,
  .try-ai-modal__compare--no-original .try-ai-modal__compare-label {
    display: none;
  }

  /* ── Result: product panel (mirrors product page style) ── */
  .try-ai-modal__product-panel {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: 'Montserrat', sans-serif;
  }
  .try-ai-modal__product-title.product-page__title {
    font-size: 1.15rem !important;
    margin: 0;
  }
  .try-ai-modal__product-panel .product-page__vendor {
    align-self: flex-start;
  }
  .try-ai-modal__product-panel .product-page__price-row {
    margin: 2px 0 0;
  }
  .try-ai-modal__product-panel .product-page__stock-alert {
    margin-bottom: 0;
  }
  .try-ai-modal__option {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .try-ai-modal__status {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.8rem;
    margin: 12px 0 0;
    min-height: 1.2em;
    color: #666;
  }
  .try-ai-modal__status.is-error {
    color: #ce0570;
  }
  .try-ai-modal__status.is-success {
    color: #2e7d32;
  }

  .try-ai-modal__footer {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 20px;
    border-top: 1px solid #e8e2d9;
    flex-shrink: 0;
    background: #faf8f4;
  }
  .try-ai-modal__footer[hidden] {
    display: none;
  }
  .try-ai-modal__footer--upload {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .try-ai-modal__footer .try-ai-modal__privacy {
    flex: 1;
    min-width: 180px;
  }
  .try-ai-modal__footer--upload .try-ai-modal__btn {
    width: auto;
    flex-shrink: 0;
  }

  /* ── Buttons ── */
  .try-ai-modal__btn {
    height: 46px;
    padding: 0 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.2s, background 0.15s, border-color 0.15s;
    border: none;
  }
  .try-ai-modal__btn--block {
    width: 100%;
  }
  .try-ai-modal__btn--primary {
    background: #993556;
    color: #fff;
  }
  .try-ai-modal__btn--primary:hover {
    opacity: 0.9;
  }
  .try-ai-modal__btn--primary:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .try-ai-modal__btn.is-loading {
    opacity: 0.7;
