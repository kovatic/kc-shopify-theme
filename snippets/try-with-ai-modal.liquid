{% javascript %}
  (function () {
    var modal = document.getElementById('try-ai-modal');
    if (!modal) return;

    var BACKEND_URL             = (modal.dataset.backendUrl || '').replace(/\/+$/, '');
    var PRODUCT_IMAGE_URL       = modal.dataset.productImage || '';
    var PRODUCT_ID              = modal.dataset.productId || '';
    var PRODUCT_URL             = modal.dataset.productUrl || '';
    var PRODUCT_TITLE           = modal.dataset.productTitle || '';
    var PRIVACY_URL             = modal.dataset.privacyUrl || '/pages/privacy-policy';
    var CUSTOMER_ID             = modal.dataset.customerId || '';
    var POLL_INTERVAL_MS        = 2500;
    var POLL_TIMEOUT_MS         = 120000;
    var ESTIMATED_DURATION_MS   = 45000;
    var DEBUG = /[?&]try_ai_debug=1/.test(window.location.search) || window.localStorage.getItem('tryAiDebug') === '1';

    function debugLog() {
      if (!DEBUG) return;
      var args = Array.prototype.slice.call(arguments);
      args.unshift('[Try with AI]');
      console.log.apply(console, args);
    }

    var I18N = {
      uploadButton:  modal.dataset.i18nUploadButton  || 'Generate try-on',
      uploading:     modal.dataset.i18nUploading      || 'Uploading…',
      generating:    modal.dataset.i18nGenerating     || 'Generating your try-on…',
      uploadSuccess: modal.dataset.i18nUploadSuccess  || 'Here is your AI try-on!',
      uploadError:   modal.dataset.i18nUploadError    || 'Something went wrong. Please try again.',
      stepUploading: modal.dataset.i18nStepUploading  || 'Uploading your photo…',
      stepStyling:   modal.dataset.i18nStepStyling    || 'AI is styling your saree…',
      stepDraping:   modal.dataset.i18nStepDraping    || 'Draping fabric…',
      stepAdjusting: modal.dataset.i18nStepAdjusting  || 'Adjusting fit…',
      stepFinishing: modal.dataset.i18nStepFinishing  || 'Finishing details…',
      stepAlmostDone: modal.dataset.i18nStepAlmostDone || 'Almost done…',
      stepLovingIt:   modal.dataset.i18nStepLovingIt   || 'Hope you\'ll love the output…',
      addToCart:     modal.dataset.i18nAddToCart      || 'Add to bag',
      addedToCart:   modal.dataset.i18nAddedToCart    || 'Added!',
      download:      modal.dataset.i18nDownload       || 'Save',
      share:         modal.dataset.i18nShare          || 'Share',
      privacyRequired: modal.dataset.i18nPrivacyRequired || 'Please agree to the Privacy Policy to continue.',
      shareText:       modal.dataset.i18nShareText        || 'Check out my AI saree try-on from ' + PRODUCT_TITLE + '!'
    };

    var dropzone           = document.getElementById('try-ai-dropzone');
    var fileInput          = document.getElementById('try-ai-file-input');
    var previewImg         = document.getElementById('try-ai-preview-img');
    var placeholder        = document.getElementById('try-ai-dropzone-placeholder');
    var statusEl           = document.getElementById('try-ai-status');
    var uploadBtn          = document.getElementById('try-ai-upload-btn');
    var retryBtn           = document.getElementById('try-ai-retry-btn');
    var atcBtn             = document.getElementById('try-ai-atc-btn');
    var downloadBtn        = document.getElementById('try-ai-download-btn');
    var shareBtn           = document.getElementById('try-ai-share-btn');
    var shareMenu          = document.getElementById('try-ai-share-menu');
    var privacyCheckbox    = document.getElementById('try-ai-privacy-checkbox');
    var resultImg          = document.getElementById('try-ai-result-img');
    var originalImg        = document.getElementById('try-ai-original-img');
    var compareEl          = document.getElementById('try-ai-compare');
    var compareBeforeWrap  = document.getElementById('try-ai-compare-before-wrap');
    var compareHandle      = document.getElementById('try-ai-compare-handle');
    var loadingStepEl      = document.getElementById('try-ai-loading-step');
    var loadingImg         = document.getElementById('try-ai-loading-img');
    var progressFillEl     = document.getElementById('try-ai-progress-fill');
    var progressPctEl      = document.getElementById('try-ai-progress-pct');
    var progressEtaEl      = document.getElementById('try-ai-progress-eta');
    var modalPriceDisplay  = document.getElementById('try-ai-price-display');
    var modalStockAlert    = document.getElementById('try-ai-stock-alert');
    var modalOptionBtns    = modal.querySelectorAll('.try-ai-modal__option-btn');

    var stepUpload  = document.getElementById('try-ai-step-upload');
    var stepLoading = document.getElementById('try-ai-step-loading');
    var stepResult  = document.getElementById('try-ai-step-result');
    var footerUpload = document.getElementById('try-ai-footer-upload');
    var footerResult = document.getElementById('try-ai-footer-result');

    var selectedFile = null;
    var pollTimer = null;
    var loadingStepTimer = null;
    var progressTimer = null;
    var progressStartedAt = 0;

    function setStatus(text, type) {
      statusEl.textContent = text || '';
      statusEl.classList.remove('is-error', 'is-success');
      if (type) statusEl.classList.add('is-' + type);
    }

    function stopPolling() {
      if (pollTimer) {
        clearTimeout(pollTimer);
        pollTimer = null;
      }
    }

    function stopLoadingSteps() {
      if (loadingStepTimer) {
        clearInterval(loadingStepTimer);
        loadingStepTimer = null;
      }
    }

    function startLoadingSteps() {
      var steps = [
        I18N.stepUploading,
        I18N.stepStyling,
        I18N.stepDraping,
        I18N.stepAdjusting,
        I18N.stepLovingIt,
        I18N.stepFinishing,
        I18N.stepAlmostDone
      ];
      var i = 0;
      loadingStepEl.textContent = steps[0];
      stopLoadingSteps();
      loadingStepTimer = setInterval(function () {
        i = Math.min(i + 1, steps.length - 1);
        loadingStepEl.textContent = steps[i];
      }, 4000);
    }

    function stopProgress() {
      if (progressTimer) {
        clearInterval(progressTimer);
        progressTimer = null;
      }
    }

    function startProgress() {
      stopProgress();
      progressStartedAt = Date.now();
      progressFillEl.style.width = '0%';
      progressPctEl.textContent = '0%';
      progressEtaEl.textContent = '';
      progressTimer = setInterval(function () {
        var elapsed = Date.now() - progressStartedAt;
        var ratio = Math.min(elapsed / ESTIMATED_DURATION_MS, 0.95);
        var pct = Math.round(ratio * 100);
        progressFillEl.style.width = pct + '%';
        progressPctEl.textContent = pct + '%';
        var remainingMs = ESTIMATED_DURATION_MS - elapsed;
        if (remainingMs > 0) {
          progressEtaEl.textContent = '~' + Math.ceil(remainingMs / 1000) + 's left';
        } else {
          progressEtaEl.textContent = '';
        }
      }, 400);
    }

    function finishProgress() {
      stopProgress();
      progressFillEl.style.width = '100%';
      progressPctEl.textContent = '100%';
      progressEtaEl.textContent = '';
    }

    function showUploadStep() {
      stepUpload.hidden = false;
      stepLoading.hidden = true;
      stepResult.hidden = true;
      footerUpload.hidden = false;
      footerResult.hidden = true;
      modal.classList.remove('is-result-active');
      stopLoadingSteps();
      stopProgress();
    }

    function showLoadingStep(photoUrl) {
      stepUpload.hidden = true;
      stepLoading.hidden = false;
      stepResult.hidden = true;
      footerUpload.hidden = true;
      footerResult.hidden = true;
      modal.classList.remove('is-result-active');
      if (photoUrl) loadingImg.src = photoUrl;
      startLoadingSteps();
      startProgress();
    }

    function syncProductPanel() {
      var pagePriceDisplay = document.getElementById('product-price-display');
      if (pagePriceDisplay && modalPriceDisplay) {
        modalPriceDisplay.innerHTML = pagePriceDisplay.innerHTML;
      }
      var pageStockAlert = document.getElementById('stock-alert');
      if (pageStockAlert && modalStockAlert) {
        modalStockAlert.className = pageStockAlert.className;
        modalStockAlert.innerHTML = pageStockAlert.innerHTML;
        if (pageStockAlert.style.display === 'none') {
          modalStockAlert.style.display = 'none';
        } else {
          modalStockAlert.removeAttribute('style');
        }
      }
      var pageOptionBtns = document.querySelectorAll('.product-page .product-page__option-btn');
      modalOptionBtns.forEach(function (btn) {
        var idx = btn.getAttribute('data-option-index');
        var value = btn.getAttribute('data-value');
        var isSelected = false;
        pageOptionBtns.forEach(function (pageBtn) {
          if (pageBtn.getAttribute('data-option-index') === idx &&
              pageBtn.getAttribute('data-value') === value &&
              pageBtn.classList.contains('is-selected')) {
            isSelected = true;
          }
        });
        btn.classList.toggle('is-selected', isSelected);
      });
    }

    modalOptionBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var idx = btn.getAttribute('data-option-index');
        var value = btn.getAttribute('data-value');
        var pageBtn = null;
        document.querySelectorAll('.product-page .product-page__option-btn').forEach(function (candidate) {
          if (candidate.getAttribute('data-option-index') === idx && candidate.getAttribute('data-value') === value) {
            pageBtn = candidate;
          }
        });
        if (pageBtn) pageBtn.click();
        syncProductPanel();
      });
    });

    function showResultStep(hasOriginal) {
      stepUpload.hidden = true;
      stepLoading.hidden = true;
      stepResult.hidden = false;
      footerUpload.hidden = true;
      footerResult.hidden = false;
      modal.classList.add('is-result-active');
      stopLoadingSteps();
      finishProgress();
      syncProductPanel();
      compareEl.classList.toggle('try-ai-modal__compare--no-original', !hasOriginal);
      if (hasOriginal) {
        requestAnimationFrame(function () { setCompareRatio(0.5); });
      }
    }

    function setCompareRatio(ratio) {
      ratio = Math.max(0, Math.min(1, ratio));
      var widthPx = compareEl.getBoundingClientRect().width;
      compareBeforeWrap.style.width = (ratio * 100) + '%';
      compareBeforeWrap.style.setProperty('--compare-width', widthPx + 'px');
      compareHandle.style.left = (ratio * 100) + '%';
    }

    function resetState() {
      stopPolling();
      selectedFile = null;
      fileInput.value = '';
      previewImg.src = '';
      previewImg.hidden = true;
      placeholder.hidden = false;
      resultImg.src = '';
      originalImg.src = '';
      loadingImg.src = '';
      compareEl.classList.remove('try-ai-modal__compare--no-original');
      uploadBtn.disabled = true;
      uploadBtn.textContent = I18N.uploadButton;
      uploadBtn.classList.remove('is-loading');
      atcBtn.textContent = I18N.addToCart;
      atcBtn.disabled = false;
      if (privacyCheckbox) privacyCheckbox.checked = false;
      closeShareMenu();
      setStatus('', null);
      showUploadStep();
    }

    function openModal(presetResultUrl) {
      resetState();
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (presetResultUrl) {
        resultImg.src = presetResultUrl;
        originalImg.src = '';
        showResultStep(false);
      }
    }

    function closeModal() {
      stopPolling();
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    modal.querySelectorAll('.try-ai-modal__close').forEach(function (btn) {
      btn.addEventListener('click', closeModal);
    });
    modal.querySelector('.try-ai-modal__backdrop').addEventListener('click', closeModal);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
    });

    retryBtn.addEventListener('click', resetState);

    function handleFile(file) {
      if (!file || file.type.indexOf('image/') !== 0) {
        selectedFile = null;
        uploadBtn.disabled = true;
        return;
      }
      selectedFile = file;
      previewImg.src = URL.createObjectURL(file);
      previewImg.hidden = false;
      placeholder.hidden = true;
      uploadBtn.disabled = false;
      setStatus('', null);
    }

    fileInput.addEventListener('change', function () {
      handleFile(fileInput.files && fileInput.files[0]);
    });

    /* ── Drag & drop (desktop) ── */
    ['dragenter', 'dragover'].forEach(function (evtName) {
      dropzone.addEventListener(evtName, function (e) {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('is-dragover');
      });
    });
    ['dragleave', 'dragend'].forEach(function (evtName) {
      dropzone.addEventListener(evtName, function (e) {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('is-dragover');
      });
    });
    dropzone.addEventListener('drop', function (e) {
      e.preventDefault();
      e.stopPropagation();
      dropzone.classList.remove('is-dragover');
      var file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (!file) return;
      fileInput.value = '';
      handleFile(file);
    });

    /* ── Before/after compare slider ── */
    var dragging = false;

    function ratioFromClientX(clientX) {
      var rect = compareEl.getBoundingClientRect();
      return (clientX - rect.left) / rect.width;
    }

    function onDragMove(clientX) {
      setCompareRatio(ratioFromClientX(clientX));
    }

    compareHandle.addEventListener('mousedown', function (e) {
      dragging = true;
      e.preventDefault();
    });
    compareHandle.addEventListener('touchstart', function () {
      dragging = true;
    }, { passive: true });

    document.addEventListener('mousemove', function (e) {
      if (dragging) onDragMove(e.clientX);
    });
    document.addEventListener('touchmove', function (e) {
      if (dragging && e.touches[0]) onDragMove(e.touches[0].clientX);
    }, { passive: true });

    document.addEventListener('mouseup', function () { dragging = false; });
    document.addEventListener('touchend', function () { dragging = false; });

    compareEl.addEventListener('click', function (e) {
      if (e.target === compareHandle || compareHandle.contains(e.target)) return;
      onDragMove(e.clientX);
    });

    window.addEventListener('resize', function () {
      if (!stepResult.hidden) {
        var current = compareBeforeWrap.getBoundingClientRect().width / compareEl.getBoundingClientRect().width;
        setCompareRatio(current);
      }
    });

    /* ── Result actions: download / share / add to cart ── */
    downloadBtn.addEventListener('click', function () {
      fetch(resultImg.src)
        .then(function (r) { return r.blob(); })
        .then(function (blob) {
          var blobUrl = URL.createObjectURL(blob);
          var link = document.createElement('a');
          link.href = blobUrl;
          link.download = 'try-with-ai-result.jpg';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          setTimeout(function () { URL.revokeObjectURL(blobUrl); }, 1000);
        })
        .catch(function () {
          var link = document.createElement('a');
          link.href = resultImg.src;
          link.download = 'try-with-ai-result.jpg';
          link.target = '_blank';
          link.rel = 'noopener';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        });
    });

    function closeShareMenu() {
      shareMenu.hidden = true;
      shareBtn.setAttribute('aria-expanded', 'false');
    }

    function openShareMenu() {
      shareMenu.hidden = false;
      shareBtn.setAttribute('aria-expanded', 'true');
    }

    shareBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      if (shareMenu.hidden) openShareMenu(); else closeShareMenu();
    });

    document.addEventListener('click', function (e) {
      if (!shareMenu.hidden && !shareMenu.contains(e.target) && e.target !== shareBtn) {
        closeShareMenu();
      }
    });

    shareMenu.querySelectorAll('.try-ai-modal__share-option').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var network = btn.dataset.share;
        var shareUrl = PRODUCT_URL || window.location.href;
        var text = I18N.shareText;

        switch (network) {
          case 'whatsapp':
            window.open('https://wa.me/?text=' + encodeURIComponent(text + ' ' + shareUrl), '_blank', 'noopener');
            break;
          case 'pinterest':
            window.open('https://pinterest.com/pin/create/button/?url=' + encodeURIComponent(shareUrl) + '&media=' + encodeURIComponent(resultImg.src) + '&description=' + encodeURIComponent(text), '_blank', 'noopener');
            break;
          case 'instagram':
          case 'snapchat':
            if (navigator.share) {
              navigator.share({ title: PRODUCT_TITLE, text: text, url: shareUrl }).catch(function () {});
            } else if (navigator.clipboard) {
              navigator.clipboard.writeText(text + ' ' + shareUrl).then(function () {
                setStatus(I18N.uploadSuccess, 'success');
              }).catch(function () {});
            }
            break;
          case 'copy':
            if (navigator.clipboard) {
              navigator.clipboard.writeText(text + ' ' + shareUrl).catch(function () {});
            }
            break;
        }
        closeShareMenu();
      });
    });

    atcBtn.addEventListener('click', function () {
      var variantInput = document.getElementById('variant-id-input');
      var variantId = variantInput && variantInput.value;
      if (!variantId) return;

      atcBtn.disabled = true;
      atcBtn.classList.add('is-loading');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: parseInt(variantId, 10), quantity: 1 })
      })
      .then(function (r) { return r.json(); })
      .then(function () {
        atcBtn.textContent = I18N.addedToCart;
        closeModal();
        window.location.href = '/checkout';
      })
      .catch(function (err) {
        debugLog('add to cart failed', err);
        atcBtn.disabled = false;
        atcBtn.classList.remove('is-loading');
      });
    });

    function readErrorBody(r) {
      return r.text().then(function (text) {
        var message = text;
        try {
          var json = JSON.parse(text);
          message = json.error || (json.errors && json.errors.join(', ')) || json.message || text;
        } catch (e) {}
        return message;
      }).catch(function () { return ''; });
    }

    function uploadCustomerPhoto(file) {
      debugLog('uploading photo to', BACKEND_URL + '/api/upload', file);
      return fetch(BACKEND_URL + '/api/upload', {
        method: 'POST',
        body: (function () {
          var formData = new FormData();
          formData.append('file', file);
          return formData;
        })()
      }).then(function (r) {
        if (!r.ok) {
          return readErrorBody(r).then(function (message) {
            debugLog('upload failed', r.status, message);
            throw new Error(message || ('Photo upload failed (' + r.status + ')'));
          });
        }
        return r.json();
      }).then(function (data) {
        debugLog('upload response', data);
        var url = data && data.data && data.data.url;
        if (!data || !data.success || !url) throw new Error('Backend did not return an uploaded photo URL');
        return url;
      });
    }

    function createTryOnJob(userImageUrl) {
      var payload = {
        customerId: CUSTOMER_ID,
        productId: PRODUCT_ID,
        sareeImageUrl: PRODUCT_IMAGE_URL,
        userImageUrl: userImageUrl,
        privacyPolicyAccepted: true
      };
      debugLog('creating try-on job', BACKEND_URL + '/api/try-on', payload);
      return fetch(BACKEND_URL + '/api/try-on', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      }).then(function (r) {
        if (!r.ok) {
          return readErrorBody(r).then(function (message) {
            debugLog('try-on job creation failed', r.status, message);
            throw new Error(message || ('Failed to start AI try-on job (' + r.status + ')'));
          });
        }
        return r.json();
      }).then(function (data) {
        debugLog('try-on job created', data);
        var jobId = data && data.data && data.data.jobId;
        if (!data || !data.success || !jobId) throw new Error('Backend did not return a job id');
        return jobId;
      });
    }

    function waitForTryOnJob(jobId) {
      var startedAt = Date.now();
      function poll() {
        return fetch(BACKEND_URL + '/api/try-on/' + jobId).then(function (r) {
          if (!r.ok) {
            return readErrorBody(r).then(function (message) {
              throw new Error(message || ('Failed to check AI try-on status (' + r.status + ')'));
            });
          }
          return r.json();
        }).then(function (res) {
          debugLog('poll job', jobId, res);
          var job = res && res.data;
          if (!job) throw new Error((res && res.error) || 'Failed to check AI try-on status');
          if (job.status === 'completed' && job.outputImageUrl) {
            return job.outputImageUrl;
          }
          if (job.status === 'failed') {
            throw new Error(job.errorMessage || 'AI try-on generation failed');
          }
          if (Date.now() - startedAt > POLL_TIMEOUT_MS) {
            throw new Error('Timed out waiting for AI try-on result');
          }
          return new Promise(function (resolve) {
            pollTimer = setTimeout(resolve, POLL_INTERVAL_MS);
          }).then(poll);
        });
      }
      return poll();
    }

    uploadBtn.addEventListener('click', function () {
      if (!selectedFile) return;
      if (privacyCheckbox && !privacyCheckbox.checked) {
        setStatus(I18N.privacyRequired, 'error');
        privacyCheckbox.focus();
        return;
      }
      if (!BACKEND_URL) {
        setStatus(I18N.uploadError, 'error');
        return;
      }
      var originalObjectUrl = previewImg.src;
      showLoadingStep(originalObjectUrl);
      setStatus('', null);

      uploadCustomerPhoto(selectedFile)
        .then(function (customerImageUrl) {
          return createTryOnJob(customerImageUrl);
        })
        .then(function (jobId) { return waitForTryOnJob(jobId); })
        .then(function (outputImageUrl) {
          originalImg.src = originalObjectUrl;
          resultImg.src = outputImageUrl;
          showResultStep(true);
          setStatus(I18N.uploadSuccess, 'success');
        })
        .catch(function (err) {
          console.error('Try with AI error:', err);
          var message = (err && err.message) ? err.message : I18N.uploadError;
          showUploadStep();
          setStatus(message, 'error');
          uploadBtn.disabled = false;
          uploadBtn.textContent = I18N.uploadButton;
        });
    });

    window.openTryWithAiModal = openModal;

    window.tryAiDebug = {
      enable: function () { window.localStorage.setItem('tryAiDebug', '1'); location.reload(); },
      disable: function () { window.localStorage.removeItem('tryAiDebug'); location.reload(); },
      config: function () {
        return { backendUrl: BACKEND_URL, productImageUrl: PRODUCT_IMAGE_URL, productId: PRODUCT_ID };
      }
    };
  })();
{% endjavascript %}
