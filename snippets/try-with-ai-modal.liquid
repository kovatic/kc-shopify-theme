  }
  .try-ai-modal__ghost-btn:hover {
    border-color: #2e1f1f;
    background: #fff;
  }
  .try-ai-modal__share-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .try-ai-modal__share-menu {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    z-index: 10;
