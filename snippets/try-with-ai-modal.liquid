{% doc %}
  Renders the "Try with AI" upload modal. Customer picks/uploads a photo of
  themselves; the photo is uploaded directly to the KC Wear AI backend, which
  generates an AI saree try-on image using the product image, and the result
  is polled for and displayed.

  Requires the KC Wear AI backend base URL, configured via the theme setting
  `try_with_ai_backend_url`.

  @param {product} product - The product being tried on
  @param {string} [backend_url] - Base URL of the KC Wear AI backend (e.g. https://kc-wear-ai.vercel.app)

  @example
  {% render 'try-with-ai-modal', product: product, backend_url: settings.try_with_ai_backend_url %}
{% enddoc %}

<div
  class="try-ai-modal"
  id="try-ai-modal"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'try_with_ai.modal_title' | t | escape }}"
  data-backend-url="{{ backend_url }}"
  data-product-image="https:{{ product.featured_image | image_url: width: 1024 }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ shop.url }}{{ product.url }}"
  data-product-title="{{ product.title | escape }}"
  data-customer-id="{{ customer.id }}"
  data-privacy-url="{{ pages.privacy-policy.url | default: '/pages/privacy-policy' }}"
  data-i18n-upload-button="{{ 'try_with_ai.upload_button' | t | escape }}"
  data-i18n-uploading="{{ 'try_with_ai.uploading' | t | escape }}"
  data-i18n-generating="{{ 'try_with_ai.generating' | t | escape }}"
  data-i18n-upload-success="{{ 'try_with_ai.upload_success' | t | escape }}"
  data-i18n-upload-error="{{ 'try_with_ai.upload_error' | t | escape }}"
  data-i18n-step-uploading="{{ 'try_with_ai.step_uploading' | t | escape }}"
  data-i18n-step-styling="{{ 'try_with_ai.step_styling' | t | escape }}"
  data-i18n-step-draping="{{ 'try_with_ai.step_draping' | t | escape }}"
  data-i18n-step-adjusting="{{ 'try_with_ai.step_adjusting' | t | escape }}"
  data-i18n-step-finishing="{{ 'try_with_ai.step_finishing' | t | escape }}"
  data-i18n-step-almost-done="{{ 'try_with_ai.step_almost_done' | t | escape }}"
  data-i18n-step-loving-it="{{ 'try_with_ai.step_loving_it' | t | escape }}"
  data-i18n-view-original="{{ 'try_with_ai.view_original' | t | escape }}"
  data-i18n-view-result="{{ 'try_with_ai.view_result' | t | escape }}"
  data-i18n-add-to-cart="{{ 'try_with_ai.add_to_cart' | t | escape }}"
  data-i18n-added-to-cart="{{ 'try_with_ai.added_to_cart' | t | escape }}"
  data-i18n-download="{{ 'try_with_ai.download' | t | escape }}"
  data-i18n-share="{{ 'try_with_ai.share' | t | escape }}"
  data-i18n-privacy-required="{{ 'try_with_ai.privacy_required' | t | escape }}"
  data-i18n-share-text="{{ 'try_with_ai.share_text' | t | escape }}"
>
  <div class="try-ai-modal__backdrop"></div>
  <div class="try-ai-modal__panel">

    <button type="button" class="try-ai-modal__close" aria-label="{{ 'try_with_ai.close' | t }}">
      <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>

    <div class="try-ai-modal__body">

      <div class="try-ai-modal__step" id="try-ai-step-upload">
        <label class="try-ai-modal__dropzone" for="try-ai-file-input" id="try-ai-dropzone">
          <img class="try-ai-modal__preview-img" id="try-ai-preview-img" alt="" hidden>
          <span class="try-ai-modal__dropzone-placeholder" id="try-ai-dropzone-placeholder">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 16V4M12 4l-4 4M12 4l4 4"/>
              <path d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
            </svg>
            <span class="try-ai-modal__dropzone-label">{{ 'try_with_ai.choose_photo' | t }}</span>
            <span class="try-ai-modal__dropzone-helper">{{ 'try_with_ai.choose_photo_helper' | t }}</span>
          </span>
        </label>
        <input type="file" accept="image/*" id="try-ai-file-input" class="try-ai-modal__file-input">

        <ul class="try-ai-modal__tips">
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            {{ 'try_with_ai.tip_full_length' | t }}
          </li>
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            {{ 'try_with_ai.tip_plain_background' | t }}
          </li>
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            {{ 'try_with_ai.tip_even_lighting' | t }}
          </li>
        </ul>
      </div>

      <div class="try-ai-modal__step" id="try-ai-step-loading" hidden>
        <div class="try-ai-modal__loading">
          <img class="try-ai-modal__loading-img" id="try-ai-loading-img" alt="" aria-hidden="true">
          <div class="try-ai-modal__loading-mask" aria-hidden="true"></div>
          <div class="try-ai-modal__loading-scan" aria-hidden="true">
            <span class="try-ai-modal__loading-scan-line"></span>
            <span class="try-ai-modal__loading-corner try-ai-modal__loading-corner--tl"></span>
            <span class="try-ai-modal__loading-corner try-ai-modal__loading-corner--tr"></span>
            <span class="try-ai-modal__loading-corner try-ai-modal__loading-corner--bl"></span>
            <span class="try-ai-modal__loading-corner try-ai-modal__loading-corner--br"></span>
          </div>
          <div class="try-ai-modal__loading-overlay">
            <div class="try-ai-modal__loading-sparkle" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.5l1.8 4.9 4.9 1.8-4.9 1.8L12 15.9l-1.8-4.9-4.9-1.8 4.9-1.8L12 2.5z"/>
              </svg>
            </div>
            <p class="try-ai-modal__loading-step" id="try-ai-loading-step"></p>
            <div class="try-ai-modal__loading-progress">
              <div class="try-ai-modal__loading-progress-track">
                <div class="try-ai-modal__loading-progress-fill" id="try-ai-progress-fill"></div>
              </div>
              <div class="try-ai-modal__loading-progress-meta">
                <span id="try-ai-progress-pct">0%</span>
                <span id="try-ai-progress-eta"></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="try-ai-modal__step try-ai-modal__step--result" id="try-ai-step-result" hidden>
        <div class="try-ai-modal__compare" id="try-ai-compare">
          <img class="try-ai-modal__compare-img try-ai-modal__compare-img--after" id="try-ai-result-img" alt="{{ 'try_with_ai.result_alt' | t }}">
          <div class="try-ai-modal__compare-before-wrap" id="try-ai-compare-before-wrap">
            <img class="try-ai-modal__compare-img try-ai-modal__compare-img--before" id="try-ai-original-img" alt="{{ 'try_with_ai.original_alt' | t }}">
          </div>
          <div class="try-ai-modal__compare-handle" id="try-ai-compare-handle">
            <span class="try-ai-modal__compare-handle-grip">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/>
              </svg>
            </span>
          </div>
          <span class="try-ai-modal__compare-label try-ai-modal__compare-label--before">{{ 'try_with_ai.view_original' | t }}</span>
          <span class="try-ai-modal__compare-label try-ai-modal__compare-label--after">{{ 'try_with_ai.view_result' | t }}</span>
        </div>

        <div class="try-ai-modal__product-panel" id="try-ai-product-panel">
          <h3 class="product-page__title try-ai-modal__product-title">{{ product.title }}</h3>

          {%- if product.collections.first != blank -%}
            <a href="{{ product.collections.first.url }}" class="product-page__vendor">{{ product.collections.first.title }}</a>
          {%- endif -%}

          <div class="product-page__price-row">
            <span class="product-page__price" id="try-ai-price-display">
              <span class="product-page__price-current{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %} is-on-sale{% endif %}">{{ product.selected_or_first_available_variant.price | money }}</span>
              <span class="product-page__price-compare" {% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}style="display: none;"{% endunless %}>
                {{ product.selected_or_first_available_variant.compare_at_price | money }}
              </span>
              <span class="product-page__price-discount-badge" {% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}style="display: none !important;"{% endunless %}>
                {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
                  {%- assign try_ai_savings = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | times: 100 | divided_by: product.selected_or_first_available_variant.compare_at_price -%}
                  -{{ try_ai_savings }}%
                {%- endif -%}
              </span>
            </span>
          </div>

          <div class="product-page__stock-alert" id="try-ai-stock-alert" style="display:none"></div>

          {%- if product.variants.size > 1 -%}
            {%- for option in product.options_with_values -%}
              {%- assign try_ai_option_index = forloop.index0 -%}
              {%- assign try_ai_current_option_value = product.selected_or_first_available_variant.options[try_ai_option_index] -%}
              <div class="try-ai-modal__option">
                <label class="product-page__option-label">{{ option.name }}</label>
                <div class="product-page__option-values try-ai-modal__option-values">
                  {%- for value in option.values -%}
                    <button type="button" class="product-page__option-btn try-ai-modal__option-btn{% if try_ai_current_option_value == value %} is-selected{% endif %}" data-option-index="{{ try_ai_option_index }}" data-value="{{ value }}">{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <p class="try-ai-modal__status" id="try-ai-status" aria-live="polite"></p>
    </div>

    <div class="try-ai-modal__footer try-ai-modal__footer--upload" id="try-ai-footer-upload">
      <label class="try-ai-modal__privacy" for="try-ai-privacy-checkbox">
        <input type="checkbox" id="try-ai-privacy-checkbox">
        <span>
          {{ 'try_with_ai.privacy_text_prefix' | t }}
          <a href="{{ pages.privacy-policy.url | default: '/pages/privacy-policy' }}" target="_blank" rel="noopener">{{ 'try_with_ai.privacy_link_text' | t }}</a>
        </span>
      </label>
      <button type="button" class="try-ai-modal__btn try-ai-modal__btn--primary try-ai-modal__btn--block" id="try-ai-upload-btn" disabled>
        {{ 'try_with_ai.upload_button' | t }}
      </button>
    </div>

    <div class="try-ai-modal__footer try-ai-modal__footer--result" id="try-ai-footer-result" hidden>
      <div class="try-ai-modal__footer-row">
        <button type="button" class="try-ai-modal__ghost-btn" id="try-ai-download-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12M12 15l-4-4M12 15l4-4"/>
            <path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
          </svg>
          <span>{{ 'try_with_ai.save' | t }}</span>
        </button>
        <div class="try-ai-modal__share-wrap">
          <button type="button" class="try-ai-modal__ghost-btn" id="try-ai-share-btn" aria-haspopup="true" aria-expanded="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18" cy="5" r="2.4"/><circle cx="6" cy="12" r="2.4"/><circle cx="18" cy="19" r="2.4"/>
              <path d="M8.2 10.8l7.6-4.4M8.2 13.2l7.6 4.4"/>
            </svg>
            <span>{{ 'try_with_ai.share' | t }}</span>
          </button>
          <div class="try-ai-modal__share-menu" id="try-ai-share-menu" hidden>
            <button type="button" class="try-ai-modal__share-option" data-share="whatsapp">
              <span class="try-ai-modal__share-icon try-ai-modal__share-icon--whatsapp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.6-.8-1.9-.9-.2-.1-.4-.1-.6.1-.2.2-.6.9-.8 1.1-.1.2-.3.2-.5.1-1.4-.6-2.3-1.4-3.2-2.8-.1-.2-.1-.4.1-.5.2-.2.5-.5.6-.7.1-.2.1-.4 0-.6-.1-.2-.7-1.6-.9-2.1-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.2-.6.4-.7.8-1 1.7-1 2.7.1 1.5 1.1 3 2.5 4.2 1.7 1.5 3.1 2 5 2.3.5.1 1 0 1.4-.1.5-.2 1.4-1 1.6-1.5.2-.5.2-.9.1-1-.1-.1-.2-.1-.6-.3z"/><path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.7 1.5 5.2L2 22l4.9-1.4C8.3 21.5 10.1 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.2c-1.7 0-3.4-.5-4.8-1.4l-.3-.2-3 .8.8-3-.2-.3C3.5 14.5 3 13.3 3 12c0-4.9 4.1-9 9-9s9 4.1 9 9-4.1 9.2-9 9.2z"/></svg>
              </span>
              <span>WhatsApp</span>
            </button>
            <button type="button" class="try-ai-modal__share-option" data-share="pinterest">
              <span class="try-ai-modal__share-icon try-ai-modal__share-icon--pinterest">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.3-.1-.8-.2-2 0-2.8.2-.8 1.3-5.4 1.3-5.4s-.3-.7-.3-1.6c0-1.6.9-2.7 2-2.7 1 0 1.4.7 1.4 1.6 0 1-.6 2.4-.9 3.7-.3 1.1.5 2 1.6 2 1.9 0 3.2-2.4 3.2-5.3 0-2.2-1.5-3.8-4.2-3.8-3.1 0-5 2.3-5 4.8 0 .9.3 1.5.7 2 .2.2.2.3.1.5l-.3 1c-.1.3-.3.4-.6.3-1.6-.7-2.4-2.5-2.4-4.6 0-3.4 2.9-7.5 8.6-7.5 4.6 0 7.6 3.3 7.6 6.9 0 4.7-2.7 8.2-6.6 8.2-1.3 0-2.6-.7-3-1.6 0 0-.7 2.9-.9 3.6-.2.8-.6 1.6-1 2.2.9.3 1.9.4 2.9.4 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
              </span>
              <span>Pinterest</span>
            </button>
            <button type="button" class="try-ai-modal__share-option" data-share="instagram">
              <span class="try-ai-modal__share-icon try-ai-modal__share-icon--instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c-2.7 0-3.1 0-4.1.1-1.1 0-1.8.2-2.4.4-.7.3-1.2.6-1.7 1.1-.5.5-.9 1.1-1.1 1.7-.2.6-.4 1.4-.4 2.4C2.2 8.7 2.2 9.1 2.2 12s0 3.1.1 4.1c0 1.1.2 1.8.4 2.4.3.7.6 1.2 1.1 1.7.5.5 1.1.9 1.7 1.1.6.2 1.4.4 2.4.4 1 .1 1.4.1 4.1.1s3.1 0 4.1-.1c1.1 0 1.8-.2 2.4-.4.7-.3 1.2-.6 1.7-1.1.5-.5.9-1.1 1.1-1.7.2-.6.4-1.4.4-2.4.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c0-1.1-.2-1.8-.4-2.4-.3-.7-.6-1.2-1.1-1.7-.5-.5-1.1-.9-1.7-1.1-.6-.2-1.4-.4-2.4-.4C15.1 2.2 14.7 2.2 12 2.2zm0 1.8c2.6 0 3 0 4 .1.9 0 1.5.2 1.8.3.5.2.8.4 1.1.7.3.3.6.7.7 1.1.1.3.3.9.3 1.8.1 1 .1 1.4.1 4s0 3-.1 4c0 .9-.2 1.5-.3 1.8-.2.5-.4.8-.7 1.1-.3.3-.7.6-1.1.7-.3.1-.9.3-1.8.3-1 .1-1.4.1-4 .1s-3 0-4-.1c-.9 0-1.5-.2-1.8-.3-.5-.2-.8-.4-1.1-.7-.3-.3-.6-.7-.7-1.1-.1-.3-.3-.9-.3-1.8-.1-1-.1-1.4-.1-4s0-3 .1-4c0-.9.2-1.5.3-1.8.2-.5.4-.8.7-1.1.3-.3.7-.6 1.1-.7.3-.1.9-.3 1.8-.3 1-.1 1.4-.1 4-.1z"/><path d="M12 7a5 5 0 100 10 5 5 0 000-10zm0 8.2a3.2 3.2 0 110-6.4 3.2 3.2 0 010 6.4z"/><circle cx="17.4" cy="6.6" r="1.2"/></svg>
              </span>
              <span>Instagram</span>
            </button>
            <button type="button" class="try-ai-modal__share-option" data-share="snapchat">
              <span class="try-ai-modal__share-icon try-ai-modal__share-icon--snapchat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5c3 0 5 2.2 5 5.4 0 1 0 2 .1 2.6.1.3.6.5 1 .6.5.1 1.1.4 1.1.9 0 .4-.4.7-.8.9.2.5-.1.9-.6 1.1-.4.1-.4.3-.3.6.1.3.3.7-.2.9-.4.2-1 .1-1.4.3-.3.2-.3.7-.9.9-.6.2-1.3-.2-2.2-.2-.8 0-1.3.6-2.4.6s-1.6-.6-2.4-.6c-.9 0-1.6.4-2.2.2-.6-.2-.6-.7-.9-.9-.4-.2-1-.1-1.4-.3-.5-.2-.3-.6-.2-.9.1-.3.1-.5-.3-.6-.5-.2-.8-.6-.6-1.1-.4-.2-.8-.5-.8-.9 0-.5.6-.8 1.1-.9.4-.1.9-.3 1-.6.1-.6.1-1.6.1-2.6 0-3.2 2-5.4 5-5.4z"/></svg>
              </span>
              <span>Snapchat</span>
            </button>
            <button type="button" class="try-ai-modal__share-option" data-share="copy">
              <span class="try-ai-modal__share-icon try-ai-modal__share-icon--copy">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/></svg>
              </span>
              <span>{{ 'try_with_ai.copy_link' | t }}</span>
            </button>
          </div>
        </div>

        <button type="button" class="try-ai-modal__btn try-ai-modal__btn--primary" id="try-ai-atc-btn">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 7h12l-1 13H7L6 7z"/>
            <path d="M9 7V6a3 3 0 016 0v1"/>
          </svg>
          <span>{{ 'try_with_ai.add_to_cart' | t }}</span>
        </button>
      </div>

      <button type="button" class="try-ai-modal__retry-link" id="try-ai-retry-btn">
        {{ 'try_with_ai.try_another_photo' | t }}
      </button>
    </div>

  </div>
</div>

{% stylesheet %}
  .try-ai-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .try-ai-modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .try-ai-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.45);
  }
  .try-ai-modal__panel {
    position: relative;
    background: #faf8f4;
    border-radius: 12px;
    width: 94%;
    max-width: 460px;
    max-height: 96vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(10px);
    transition: transform 0.25s ease, max-width 0.25s ease;
    box-shadow: 0 20px 60px rgba(0,0,0,0.18);
  }
  .try-ai-modal.is-result-active .try-ai-modal__panel {
    max-width: 980px;
  }
  .try-ai-modal.is-open .try-ai-modal__panel {
    transform: translateY(0);
  }

  @keyframes try-ai-btn-icon-twinkle {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.75; transform: scale(0.9); }
  }

  .try-ai-modal__close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 28px;
    height: 28px;
    background: #fff;
    border: none;
    cursor: pointer;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0,0,0,0.18);
    transition: color 0.15s;
  }
  .try-ai-modal__close:hover { color: #666; }

  .try-ai-modal__body {
    overflow-y: auto;
    flex: 1;
    padding: 20px 20px;
  }

  .try-ai-modal__dropzone {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 220px;
    margin: 0 auto;
    border: 1.5px dashed #d4cdc4;
    border-radius: 12px;
    background: #fff;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.15s;
  }
  .try-ai-modal__dropzone .try-ai-modal__preview-img {
    height: 100%;
  }
  .try-ai-modal__dropzone:hover {
    border-color: #2e1f1f;
  }
  .try-ai-modal__dropzone.is-dragover {
    border-color: #9c2a8f;
    background: #fbf3f9;
  }
  .try-ai-modal__dropzone-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 0 20px;
    color: #888;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.8rem;
    text-align: center;
  }
  .try-ai-modal__dropzone-placeholder svg {
    margin-bottom: 6px;
  }
  .try-ai-modal__dropzone-label {
    color: #2e1f1f;
    font-weight: 600;
  }
  .try-ai-modal__dropzone-helper {
    color: #999;
    font-size: 0.72rem;
  }
  .try-ai-modal__dropzone-placeholder[hidden] {
    display: none;
  }
  .try-ai-modal__preview-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .try-ai-modal__preview-img[hidden] {
    display: none;
  }
  .try-ai-modal__file-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .try-ai-modal__step[hidden] {
    display: none;
  }

  /* ── Photo tips checklist ── */
  .try-ai-modal__tips {
    list-style: none;
    margin: 12px auto 0;
    padding: 0;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .try-ai-modal__tips li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.78rem;
    color: #55504a;
  }
  .try-ai-modal__tips svg {
    flex-shrink: 0;
    color: #2e7d32;
  }

  .try-ai-modal__privacy {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.72rem;
    line-height: 1.4;
    color: #666;
