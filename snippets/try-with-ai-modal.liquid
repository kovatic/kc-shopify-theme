  }

  .try-ai-modal__footer-row {
    display: flex;
    align-items: stretch;
    gap: 8px;
  }
  .try-ai-modal__footer-row .try-ai-modal__btn {
    flex: 1;
    min-width: 0;
  }
  .try-ai-modal__ghost-btn {
    flex-shrink: 0;
