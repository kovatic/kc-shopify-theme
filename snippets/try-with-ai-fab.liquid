{% doc %}
  Renders the floating "Try with AI" pill button overlaid on a product
  image. Only rendered when the product has AI try-on enabled.

  @param {product} product - The product to try on

  @example
  {% render 'try-with-ai-fab', product: product %}
{% enddoc %}

{%- if product.metafields.custom.try_with_ai.value == true -%}
  {%- if customer -%}
    <button type="button" class="try-ai-fab js-try-ai-btn" aria-label="{{ 'try_with_ai.cta_label' | t | escape }}">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="try-ai-fab__icon">
        <path d="M12 2.5l1.8 4.9 4.9 1.8-4.9 1.8L12 15.9l-1.8-4.9-4.9-1.8 4.9-1.8L12 2.5z"/>
        <path d="M19 14l.9 2.5L22.4 17.4l-2.5.9L19 20.8l-.9-2.5-2.5-.9 2.5-.9L19 14z"/>
      </svg>
      <span>{{ 'try_with_ai.cta_label' | t }}</span>
    </button>
  {%- else -%}
    <a href="{{ routes.account_login_url }}" class="try-ai-fab" aria-label="{{ 'try_with_ai.login_required' | t | escape }}">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="try-ai-fab__icon">
        <path d="M12 2.5l1.8 4.9 4.9 1.8-4.9 1.8L12 15.9l-1.8-4.9-4.9-1.8 4.9-1.8L12 2.5z"/>
        <path d="M19 14l.9 2.5L22.4 17.4l-2.5.9L19 20.8l-.9-2.5-2.5-.9 2.5-.9L19 14z"/>
      </svg>
      <span>{{ 'try_with_ai.cta_label' | t }}</span>
    </a>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .try-ai-fab {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: #14101c;
    color: #fff;
    border: 1.5px solid transparent;
    border-radius: 999px;
    background-clip: padding-box;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .try-ai-fab::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    padding: 1.5px;
    background: linear-gradient(100deg, #4fd1c5, #4b2a7b 30%, #9c2a8f 55%, #c3134e 75%, #d98a2b 100%);
    background-size: 220% 100%;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: try-ai-fab-gradient 6s ease infinite;
    pointer-events: none;
  }
  @keyframes try-ai-fab-gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  .try-ai-fab:hover {
    transform: scale(1.03);
    box-shadow: 0 4px 16px rgba(0,0,0,0.25);
  }
  .try-ai-fab__icon {
    flex-shrink: 0;
    color: #d98a2b;
    animation: try-ai-btn-icon-twinkle 2.4s ease-in-out infinite;
  }
  @keyframes try-ai-btn-icon-twinkle {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.75; transform: scale(0.9); }
  }

  @media screen and (max-width: 600px) {
    .try-ai-fab {
      top: auto;
      bottom: 90px;
      right: 12px;
      padding: 9px 16px;
      font-size: 0.82rem;
      white-space: nowrap;
    }
    .try-ai-fab__icon {
      width: 17px;
      height: 17px;
    }
  }
{% endstylesheet %}
